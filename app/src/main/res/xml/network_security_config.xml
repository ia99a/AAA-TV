<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted connections only. The one exception is the official Quran channel's backup stream,
     which is only published over plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">m.live.net.sa</domain>
    </domain-config>
</network-security-config>
